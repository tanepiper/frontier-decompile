{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./gameframe *)",
      "Bash(scripts/ghidra-export.sh *)",
      "Bash(scripts/ghidra-run.sh *)",
      "Bash(scripts/dosbox-run.sh *)",
      "Bash(scripts/extract-installer.sh *)",
      "Bash(scripts/setup.sh)",
      "Bash(tests/run.sh *)",
      "Bash(.venv/bin/python tools/*)",
      "Bash(.venv/bin/python truth/*)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git pull *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(scripts/setup.sh --install *)",
      "Bash(npx -y rea-agents@6.4.0 setup *)",
      "Bash(brew install *)",
      "Bash(sudo *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(cargo install *)"
    ],
    "deny": [
      "Bash(git add -f *)",
      "Bash(git add --force *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "python3", "args": ["${CLAUDE_PROJECT_DIR}/scripts/hooks/gate.py", "session"], "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "if": "Bash(git commit *)", "command": "python3", "args": ["${CLAUDE_PROJECT_DIR}/scripts/hooks/gate.py", "commit"], "timeout": 30 },
          { "type": "command", "if": "Bash(git push *)", "command": "python3", "args": ["${CLAUDE_PROJECT_DIR}/scripts/hooks/gate.py", "push"], "timeout": 10 }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "python3", "args": ["${CLAUDE_PROJECT_DIR}/scripts/hooks/gate.py", "write"], "timeout": 10 }
        ]
      }
    ]
  }
}
